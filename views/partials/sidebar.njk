{# Marco compartido del sidebar; menu.njk selecciona la vista específica del rol. #}
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <div class="sidebar-brand">
    <a href="/admin/panel" class="brand-link">
      <img src="/static/assets/img/favl/logo.png" alt="Logotipo FAVL" class="brand-image opacity-75 shadow" />
      <span class="brand-text fw-light">FAVL</span>
    </a>
  </div>

  <div class="sidebar-search" role="search">
    <label for="sidebar-search-input" class="visually-hidden">Filtrar menú</label>
    <input type="search" id="sidebar-search-input" class="form-control form-control-sm" placeholder="Filtrar menú…"
      autocomplete="off" data-lte-toggle="sidebar-search" data-lte-target="#navigation" />
    <p class="fs-7 text-secondary mt-2 mb-0" data-lte-search-empty role="status" hidden>
      No hay páginas coincidentes.
    </p>
  </div>

  <div class="sidebar-wrapper">
    <nav class="mt-2" aria-label="Navegación principal">
      {% include "partials/menu.njk" %}
    </nav>
  </div>
</aside>
