{# Layout del backoffice: navbar + sidebar + contenido + footer.
  Bloques: title, head (CSS extra), content, scripts (JS extra).
  Variables globales (las arma backoffice.locals.ts): user, menu, roleLabel, currentPath, year. #}
<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <title>FAVL | {% block title %}Panel de control{% endblock %}</title>
  <link rel="icon" type="image/ico" href="/static/assets/img/favl/favicon.ico">
  <script>
    (() => {
      'use strict';
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) window.location.reload();
      });
      const root = document.documentElement;
      if (root.getAttribute('data-lte-color-mode') === 'off') return;
      const STORAGE_KEY = 'lte-theme';
      let stored = null;
      try { stored = localStorage.getItem(STORAGE_KEY); } catch { }
      const authored = root.getAttribute('data-bs-theme');
      let resolved = 'light';
      if (stored === 'dark' || stored === 'light') {
        resolved = stored;
      } else if (authored === 'dark' || authored === 'light') {
        resolved = authored;
      } else if (globalThis.matchMedia('(prefers-color-scheme: dark)').matches) {
        resolved = 'dark';
      }
      root.setAttribute('data-bs-theme', resolved);
      root.style.colorScheme = resolved;
      if (resolved !== authored) root.setAttribute('data-lte-theme-resolved', '');
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#007bff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
  <meta name="author" content="FAVL" />
  <meta name="description" content="Panel de administración FAVL." />
  <meta name="supported-color-schemes" content="light dark" />
  <link rel="stylesheet" href="/static/css/adminlte.css" />
  <link rel="stylesheet" href="/static/css/index.css" />
  <link rel="stylesheet" href="/static/css/overlayscrollbars.css" />
  <link rel="stylesheet" href="/static/css/bootstrap-icons.css" />
  {% block head %}{% endblock %}
</head>

<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
  <div class="app-wrapper">

    {% include "partials/navbar.njk" %}
    {% include "partials/sidebar.njk" %}

    <main class="app-main">
      {% block content %}{% endblock %}
    </main>

    {% include "partials/footer.njk" %}
  </div>

  <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.11.0/browser/overlayscrollbars.browser.es6.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js" crossorigin="anonymous"></script>
  <script src="/static/js/adminlte.js"></script>
  <script>
    // OverlayScrollbars en el sidebar
    document.addEventListener('DOMContentLoaded', function () {
      const sidebarWrapper = document.querySelector('.sidebar-wrapper');
      const isMobile = window.innerWidth <= 992;
      if (sidebarWrapper && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined && !isMobile) {
        OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
          scrollbars: { theme: 'os-theme-light', autoHide: 'leave', clickScroll: true },
        });
      }
    });
  </script>
  {% block scripts %}{% endblock %}
</body>

</html>
