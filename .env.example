# Copiar a .env (se carga solo al arrancar). Todo es opcional en desarrollo.
PORT=3000

# Producción: OBLIGATORIA, mínimo 32 caracteres (ej.: openssl rand -hex 32).
# En desarrollo se genera una al azar y las sesiones se pierden al reiniciar.
SESSION_SECRET=

SESSION_TTL_HOURS=8
# Por defecto true en producción. Poner false solo si se sirve por HTTP.
# COOKIE_SECURE=true

# Contraseña de los usuarios de ejemplo (admin@, secretaria@, tesoreria@, comunicacion@favl.local).
# En desarrollo, si no se define, es "favl1234". En producción, sin valor no se crea ninguno.
# SEED_PASSWORD=

# Login de desarrollo: en /admin/login aparecen los usuarios de ejemplo y se entra
# con un clic, sin contraseña. Por defecto true fuera de producción.
# En producción la app NO arranca si DEV_LOGIN=true.
# DEV_LOGIN=false

# --- Sitio público y API ---
# Carpeta del frontend compilado (npm run build:frontend). Por defecto frontend/dist.
# FRONTEND_DIST=frontend/dist

# Cookie anónima del sitio público (la de /admin es SESSION_TTL_HOURS). Días de vida; se renueva al usarse.
# VISITOR_TTL_DAYS=30

# Pedidos por minuto por navegador a /api. Por IP se tolera 5 veces esto. 0 = sin límite.
# API_RATE_LIMIT_PER_MIN=120

# Poner true si hay un proxy delante (nginx, balanceador): usa X-Forwarded-For como IP real.
# TRUST_PROXY=false
