<form method="post" action="{{ action }}">
  <div class="row">
    <div class="col-md-6 mb-3">
      <label for="usuario" class="form-label">Nombre de usuario *</label>
      <input type="text" class="form-control" id="usuario" name="usuario" maxlength="50"
             value="{{ usuario.usuario or '' }}" autocomplete="username" required>
    </div>
    <div class="col-md-6 mb-3">
      <label for="email" class="form-label">Email *</label>
      <input type="email" class="form-control" id="email" name="email" maxlength="254"
             value="{{ usuario.email or '' }}" autocomplete="email" required>
    </div>
    <div class="col-md-6 mb-3">
      <label for="role" class="form-label">Rol *</label>
      <select class="form-select" id="role" name="role" required>
        <option value="">Seleccionar rol…</option>
        {% for rol in roles %}
        <option value="{{ rol.value }}" {% if usuario.role == rol.value %}selected{% endif %}>{{ rol.label }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-md-6 mb-3">
      <label for="password" class="form-label">{{ 'Nueva contraseña' if editar else 'Contraseña *' }}</label>
      <input type="password" class="form-control" id="password" name="password" minlength="8"
             autocomplete="{{ 'new-password' if editar else 'new-password' }}" {% if not editar %}required{% endif %}>
      {% if editar %}<div class="form-text">Dejala vacía para conservar la contraseña actual.</div>{% else %}
      <div class="form-text">Debe tener al menos 8 caracteres.</div>{% endif %}
    </div>
  </div>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
    <a href="/admin/usuarios" class="btn btn-outline-secondary">Cancelar</a>
  </div>
</form>
