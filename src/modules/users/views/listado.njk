{# Listado de usuarios. Recibe: usuarios[{id, usuario, email, role, activo, createdAt}]. #}
{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header, badge %}

{% block title %}Usuarios{% endblock %}

{% block content %}
{{ page_header('Usuarios', [{ label: 'Usuarios' }]) }}

<div class="app-content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Cuentas de usuario</h3>
        {% if puedeAdministrar %}
        <div class="card-tools">
          <a href="/admin/usuarios/nuevo" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo usuario
          </a>
        </div>
        {% endif %}
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead>
              <tr>
                <th>Usuario</th><th>Email</th><th>Rol</th><th>Estado</th>
                {% if puedeAdministrar %}<th class="text-end">Acciones</th>{% endif %}
              </tr>
            </thead>
            <tbody>
              {% for usuario in usuarios %}
              <tr>
                <td>{{ usuario.usuario }}</td>
                <td>{{ usuario.email }}</td>
                <td>{{ usuario.role }}</td>
                <td>{{ badge('Activo' if usuario.activo else 'Inactivo', 'success' if usuario.activo else 'secondary') }}</td>
                {% if puedeAdministrar %}
                <td>
                  <div class="d-flex justify-content-end gap-1">
                    <a href="/admin/usuarios/{{ usuario.id }}/editar" class="btn btn-sm btn-outline-primary" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    {% if usuario.activo %}
                    <form method="post" action="/admin/usuarios/{{ usuario.id }}/desactivar"
                          onsubmit="return confirm('¿Dar de baja este usuario? No podrá volver a iniciar sesión.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Dar de baja">
                        <i class="bi bi-person-x"></i>
                      </button>
                    </form>
                    {% else %}
                    <form method="post" action="/admin/usuarios/{{ usuario.id }}/activar">
                      <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivar">
                        <i class="bi bi-person-check"></i>
                      </button>
                    </form>
                    {% endif %}
                  </div>
                </td>
                {% endif %}
              </tr>
              {% else %}
              <tr><td colspan="{{ 5 if puedeAdministrar else 4 }}" class="text-center text-muted py-3">No hay usuarios cargados.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
