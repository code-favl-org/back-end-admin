{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header %}

{% block title %}Nuevo usuario{% endblock %}

{% block content %}
{{ page_header('Nuevo usuario', [{ label: 'Usuarios', href: '/admin/usuarios' }, { label: 'Nuevo' }]) }}
<div class="app-content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><h3 class="card-title">Datos de acceso</h3></div>
      <div class="card-body">
        {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
        {% include "users/views/_form.njk" %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
