{# Edición de la portada. Recibe: inicio {titulo, subtitulo, descripcion, imagenUrl} y error (mensaje de subida rechazada). Envía POST multipart /admin/web/inicio. #}
{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header %}

{% block title %}Inicio{% endblock %}

{% block content %}
{{ page_header('Inicio', [{ label: 'Gestión WEB' }, { label: 'Inicio' }]) }}

<div class="app-content">
  <div class="container-fluid">
    <form method="post" action="/admin/web/inicio" enctype="multipart/form-data">
      <div class="row">
        <div class="col-lg-8">
          <div class="card">
            <div class="card-header">
              <h3 class="card-title">Contenido de la página de inicio</h3>
              <div class="card-tools">
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-save me-1"></i> Guardar</button>
              </div>
            </div>
            <div class="card-body">
              {% if error %}
              <div class="alert alert-danger py-2">{{ error }}</div>
              {% endif %}

              <div class="mb-3">
                <label for="titulo-inicio" class="form-label">Título principal</label>
                <input type="text" class="form-control" id="titulo-inicio" name="titulo" value="{{ inicio.titulo }}">
              </div>
              <div class="mb-3">
                <label for="subtitulo-inicio" class="form-label">Subtítulo</label>
                <input type="text" class="form-control" id="subtitulo-inicio" name="subtitulo" value="{{ inicio.subtitulo }}">
              </div>
              <div class="mb-3">
                <label for="descripcion-inicio" class="form-label">Descripción</label>
                <textarea class="form-control" id="descripcion-inicio" name="descripcion" rows="5">{{ inicio.descripcion }}</textarea>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card">
            <div class="card-header"><h3 class="card-title">Imagen de portada</h3></div>
            <div class="card-body">
              <div class="mb-3">
                <label for="imagen-inicio" class="form-label">Archivo</label>
                <input type="file" class="form-control" id="imagen-inicio" name="imagen"
                  accept="image/png,image/jpeg,image/webp,image/gif">
                <div class="form-text">
                  PNG, JPG, WEBP o GIF, máx. 2 MB. Se guarda en <code>public/upload</code>.
                  {% if inicio.imagenUrl %}Si no elegís ninguno, se mantiene la actual.{% endif %}
                </div>
              </div>

              {% if inicio.imagenUrl %}
              <img src="{{ inicio.imagenUrl }}" class="img-fluid rounded border" alt="Imagen de portada actual">
              <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="quitar-imagen-inicio" name="quitarImagen" value="si">
                <label class="form-check-label" for="quitar-imagen-inicio">Quitar la imagen actual</label>
              </div>
              {% else %}
              <p class="text-body-secondary mb-0">Todavía no hay imagen cargada.</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock %}
