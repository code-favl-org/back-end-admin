{# Listado de socios. Recibe: socios[{numero, nombre, dni, club, estado}]. #}
{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header, badge, acciones %}

{% block title %}Socios{% endblock %}

{% block content %}
{{ page_header('Socios', [{ label: 'Socios' }, { label: 'Listado' }]) }}

<div class="app-content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Listado de socios</h3>
        <div class="card-tools">
          <a href="/admin/socios/nuevo" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo socio
          </a>
        </div>
      </div>
      <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
          <thead>
            <tr>
              <th>N°</th><th>Nombre</th><th>DNI</th><th>Club</th><th>Estado</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for s in socios %}
            <tr>
              <td>{{ s.numero }}</td>
              <td>{{ s.nombre }}</td>
              <td>{{ s.dni }}</td>
              <td>{{ s.club }}</td>
              <td>{{ badge(s.estado, 'success' if s.estado == 'Activo' else 'secondary') }}</td>
              <td>{{ acciones() }}</td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-3">No hay socios cargados.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
