{# Pantalla de login (independiente del layout del backoffice).
  Recibe: next (ruta a la que volver; vacío => página del rol), error?, email?. #}
<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FAVL | Ingresar</title>
  <link rel="icon" type="image/ico" href="/static/assets/img/favl/favicon.ico">
  <link rel="stylesheet" href="/static/css/adminlte.css" />
  <link rel="stylesheet" href="/static/css/bootstrap-icons.css" />
</head>

<body class="login-page bg-body-secondary">
  <div class="login-box">
    <div class="login-logo text-center mb-3">
      <img src="/static/assets/img/favl/logo.png" alt="FAVL" height="64">
    </div>
    <div class="card">
      <div class="card-body login-card-body">
        <p class="login-box-msg">Ingresá para administrar</p>

        {% if error %}<div class="alert alert-danger py-2">{{ error }}</div>{% endif %}

        <form method="post" action="/admin/login">
          <input type="hidden" name="next" value="{{ next }}">
          <div class="input-group mb-3">
            <input type="email" name="email" value="{{ email }}" class="form-control" placeholder="Email" autocomplete="email" required autofocus>
            <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
          </div>
          <div class="input-group mb-3">
            <input type="password" id="login-password" name="password" class="form-control" placeholder="Contraseña" autocomplete="current-password" required>
            <button type="button" class="input-group-text" data-toggle-password="login-password" aria-label="Mostrar contraseña" aria-pressed="false">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
      </div>
    </div>

  </div>
  <script>
    document.querySelector('[data-toggle-password="login-password"]').addEventListener('click', (event) => {
      const button = event.currentTarget;
      const input = document.getElementById(button.dataset.togglePassword);
      const visible = input.type === 'password';
      input.type = visible ? 'text' : 'password';
      button.setAttribute('aria-pressed', String(visible));
      button.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
      button.querySelector('i').classList.toggle('bi-eye', !visible);
      button.querySelector('i').classList.toggle('bi-eye-slash', visible);
    });
  </script>
</body>

</html>
