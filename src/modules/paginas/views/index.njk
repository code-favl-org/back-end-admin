{# Listado de páginas del sitio. Recibe: paginas[{titulo, slug, estado}]. #}
{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header, badge, acciones %}

{% block title %}Páginas{% endblock %}

{% block content %}
{{ page_header('Páginas', [{ label: 'Gestión WEB' }, { label: 'Páginas' }]) }}

<div class="app-content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Páginas estáticas</h3>
        <div class="card-tools">
          <button class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Nueva página</button>
        </div>
      </div>
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr><th>Título</th><th>Slug</th><th>Estado</th><th class="text-end">Acciones</th></tr>
          </thead>
          <tbody>
            {% for p in paginas %}
            <tr>
              <td>{{ p.titulo }}</td>
              <td>{{ p.slug }}</td>
              <td>{{ badge(p.estado, 'success' if p.estado == 'Publicada' else 'secondary') }}</td>
              <td>{{ acciones() }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
