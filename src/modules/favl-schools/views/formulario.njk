{% extends "layouts/base.njk" %}
{% from "macros/ui.njk" import page_header %}

{% block title %}{{ titulo }}{% endblock %}
{% block content %}
{{ page_header(titulo, [{ label: titulo, href: basePath }, { label: 'Formulario' }]) }}
<div class="app-content"><div class="container-fluid"><div class="card">
  <div class="card-header"><h3 class="card-title">{{ titulo }}</h3></div>
  <div class="card-body">
    {% if error %}<div class="alert alert-danger" role="alert">{{ error }}</div>{% endif %}
    <form method="post" action="{{ action }}">
      {% if not creating %}
      <div class="mb-3"><label class="form-label">ID</label><input type="text" class="form-control" value="{{ registro.id }}" disabled></div>
      {% endif %}
      <div class="row">
        <div class="col-md-6 mb-3"><label for="name" class="form-label">Nombre</label><input type="text" class="form-control" id="name" name="name" maxlength="100" value="{{ registro.name or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="email" class="form-label">Email</label><input type="email" class="form-control" id="email" name="email" maxlength="50" value="{{ registro.email or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="website" class="form-label">Sitio web</label><input type="text" class="form-control" id="website" name="website" maxlength="100" value="{{ registro.website or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="responsiblePilotLicenseNumber" class="form-label">Licencia del piloto responsable</label><input type="number" class="form-control" id="responsiblePilotLicenseNumber" name="responsiblePilotLicenseNumber" step="1" value="{{ registro.responsiblePilotLicenseNumber or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="address" class="form-label">Dirección</label><input type="text" class="form-control" id="address" name="address" maxlength="100" value="{{ registro.address or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="city" class="form-label">Ciudad</label><input type="text" class="form-control" id="city" name="city" maxlength="100" value="{{ registro.city or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="state" class="form-label">Provincia</label><input type="text" class="form-control" id="state" name="state" maxlength="50" value="{{ registro.state or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="postalCode" class="form-label">Código postal</label><input type="text" class="form-control" id="postalCode" name="postalCode" maxlength="10" value="{{ registro.postalCode or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="latitude" class="form-label">Latitud</label><input type="number" class="form-control" id="latitude" name="latitude" step="0.00000001" value="{{ registro.latitude or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="longitude" class="form-label">Longitud</label><input type="number" class="form-control" id="longitude" name="longitude" step="0.00000001" value="{{ registro.longitude or '' }}"></div>
        <div class="col-md-6 mb-3"><label for="schoolType" class="form-label">Tipo de escuela</label><input type="text" class="form-control" id="schoolType" name="schoolType" maxlength="2" value="{{ registro.schoolType or '' }}"></div>
      </div>
      <div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button><a href="{{ basePath }}" class="btn btn-outline-secondary">Cancelar</a></div>
    </form>
  </div>
</div></div></div>
{% endblock %}
