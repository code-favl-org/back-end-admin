{# Panel de inicio. Recibe: stats[{valor, etiqueta, color, icono}]. #}
{% extends "backoffice/shared/views/layouts/base.njk" %}
{% from "backoffice/shared/views/macros/ui.njk" import page_header %}

{% block title %}Panel de control{% endblock %}

{% block content %}
{{ page_header('Panel de control', [{ label: 'Panel' }], false) }}

<div class="app-content">
  <div class="container-fluid">
    <div class="row">
      {% for s in stats %}
      <div class="col-lg-3 col-6">
        <div class="small-box text-bg-{{ s.color }}">
          <div class="inner">
            <h3>{{ s.valor }}</h3>
            <p>{{ s.etiqueta }}</p>
          </div>
          <i class="small-box-icon bi {{ s.icono }}"></i>
        </div>
      </div>
      {% endfor %}
    </div>

    <div class="row">
      <div class="col-12">
        <div class="card">
          <div class="card-header"><h3 class="card-title">Bienvenido al panel FAVL</h3></div>
          <div class="card-body"><p>Usá el menú lateral para navegar entre las secciones.</p></div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
