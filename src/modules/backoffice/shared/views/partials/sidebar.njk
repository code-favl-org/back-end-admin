{# Menú lateral. Recorre `menu` (ya filtrado por rol y con active/open calculados en menu.ts):
  ítem con `header` = separador, con `children` = grupo desplegable, si no = enlace simple. #}
<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
  <div class="sidebar-brand">
    <a href="/admin/panel" class="brand-link">
      <img src="/static/assets/img/favl/logo.png" alt="Logotipo FAVL" class="brand-image opacity-75 shadow" />
      <span class="brand-text fw-light">FAVL</span>
    </a>
  </div>

  <div class="sidebar-search" role="search">
    <label for="sidebar-search-input" class="visually-hidden">Filtrar menú</label>
    <input type="search" id="sidebar-search-input" class="form-control form-control-sm" placeholder="Filtrar menú…"
      autocomplete="off" data-lte-toggle="sidebar-search" data-lte-target="#navigation" />
    <p class="fs-7 text-secondary mt-2 mb-0" data-lte-search-empty role="status" hidden>
      No hay páginas coincidentes.
    </p>
  </div>

  <div class="sidebar-wrapper">
    <nav class="mt-2" aria-label="Navegación principal">
      <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" data-accordion="false" id="navigation">
        {% for item in menu %}
          {% if item.header %}
            <li class="nav-header">{{ item.header }}</li>

          {% elif item.children %}
            <li class="nav-item{{ ' menu-open' if item.open }}">
              <a href="#" class="nav-link{{ ' active' if item.active }}">
                <i class="nav-icon bi {{ item.icon }}"></i>
                <p>{{ item.label }}<i class="nav-arrow bi bi-chevron-right"></i></p>
              </a>
              <ul class="nav nav-treeview">
                {% for child in item.children %}
                <li class="nav-item">
                  <a href="{{ child.href }}" class="nav-link{{ ' active' if child.active }}">
                    <i class="nav-icon bi bi-circle"></i>
                    <p>{{ child.label }}</p>
                  </a>
                </li>
                {% endfor %}
              </ul>
            </li>

          {% else %}
            <li class="nav-item">
              <a href="{{ item.href }}" class="nav-link{{ ' active' if item.active }}">
                <i class="nav-icon bi {{ item.icon }}"></i>
                <p>{{ item.label }}</p>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </nav>
  </div>
</aside>
