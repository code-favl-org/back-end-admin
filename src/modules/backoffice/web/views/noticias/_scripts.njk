{# JS del formulario de noticias: editor TinyMCE y vista previa de la portada. Va en el bloque `scripts` del layout. #}
<script src="/static/js/tinymce/tinymce.min.js"></script>
{% raw %}
<script>
  // ====== EDITOR TINYMCE ======
  tinymce.init({
    selector: '#contenido-noticia',
    license_key: 'gpl',
    height: 500,
    menubar: false,
    language: 'es',
    branding: false,
    promotion: false,
    plugins: [
      'advlist', 'autolink', 'lists', 'link', 'image', 'charmap',
      'preview', 'anchor', 'searchreplace', 'visualblocks', 'code',
      'fullscreen', 'insertdatetime', 'media', 'table', 'help', 'wordcount'
    ],
    toolbar:
      'undo redo | blocks | ' +
      'bold italic underline strikethrough | forecolor backcolor | ' +
      'alignleft aligncenter alignright alignjustify | ' +
      'bullist numlist outdent indent | ' +
      'link image media table | ' +
      'removeformat code fullscreen help',
    content_style: `
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 1rem; line-height: 1.6; color: #212529;
        max-width: 720px; margin: 0 auto; padding: 1rem;
      }
      img { max-width: 100%; height: auto; display: block; margin: 1rem auto; border-radius: 6px; }
      blockquote { border-left: 4px solid #dee2e6; padding-left: 1rem; font-style: italic; color: #6c757d; }
      h1, h2, h3, h4 { margin-top: 1.5rem; margin-bottom: 1rem; }
      p { margin-bottom: 1rem; }
    `,
    image_title: true,
    image_advtab: true,
    image_dimensions: true,
    image_caption: true,
    automatic_uploads: false,
    paste_data_images: true,
    file_picker_types: 'image',
    file_picker_callback: (callback, value, meta) => {
      if (meta.filetype !== 'image') return;
      const input = document.createElement('input');
      input.setAttribute('type', 'file');
      input.setAttribute('accept', 'image/*');
      input.addEventListener('change', () => {
        const file = input.files?.[0];
        if (!file) return;
        if (file.size > 5 * 1024 * 1024) { alert('La imagen supera los 5 MB.'); return; }
        const reader = new FileReader();
        reader.onload = () => callback(reader.result, { alt: file.name });
        reader.readAsDataURL(file);
      });
      input.click();
    },
  });

  // ====== PORTADA: selector + preview ======
  (() => {
    const inputReal = document.querySelector('#imagen-portada');
    const btn = document.querySelector('#btn-elegir-portada');
    const nombre = document.querySelector('#nombre-archivo-portada');
    const preview = document.querySelector('#preview-portada');
    if (!inputReal || !btn) return;

    btn.addEventListener('click', () => inputReal.click());
    inputReal.addEventListener('change', () => {
      const file = inputReal.files?.[0];
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) {
        preview.innerHTML = '<div class="text-danger small">La imagen supera los 2 MB.</div>';
        inputReal.value = '';
        return;
      }
      nombre.value = file.name;
      const reader = new FileReader();
      reader.onload = (e) => {
        preview.innerHTML = `<img src="${e.target.result}" class="img-fluid rounded border" alt="Portada">`;
      };
      reader.readAsDataURL(file);
    });
  })();
</script>
{% endraw %}
