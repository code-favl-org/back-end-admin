{# Pantalla de login (independiente del layout del backoffice).
  Recibe: next (ruta a la que volver; vacío => página del rol), error?, email?,
  devUsers? [{id, nombre, email, roles}] -> solo si DEV_LOGIN está activo. #}
<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FAVL | Ingresar</title>
  <link rel="icon" type="image/ico" href="/static/assets/img/favl/favicon.ico">
  <link rel="stylesheet" href="/static/css/adminlte.css" />
  <link rel="stylesheet" href="/static/css/bootstrap-icons.css" />
</head>

<body class="login-page bg-body-secondary">
  <div class="login-box">
    <div class="login-logo text-center mb-3">
      <img src="/static/assets/img/favl/logo.png" alt="FAVL" height="64">
    </div>
    <div class="card">
      <div class="card-body login-card-body">
        <p class="login-box-msg">Ingresá para administrar</p>

        {% if error %}<div class="alert alert-danger py-2">{{ error }}</div>{% endif %}

        <form method="post" action="/admin/login">
          <input type="hidden" name="next" value="{{ next }}">
          <div class="input-group mb-3">
            <input type="email" name="email" value="{{ email }}" class="form-control" placeholder="Email" autocomplete="username" required autofocus>
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
          </div>
          <div class="input-group mb-3">
            <input type="password" name="password" class="form-control" placeholder="Contraseña" autocomplete="current-password" required>
            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
          </div>
          <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
      </div>
    </div>

    {# Login de desarrollo: solo llega `devUsers` si DEV_LOGIN está activo (nunca en producción). #}
    {% if devUsers %}
    <div class="card border-warning mt-3">
      <div class="card-header text-bg-warning py-2">
        <i class="bi bi-tools me-1"></i> <strong>Modo desarrollo</strong> · entrar sin contraseña
      </div>
      <div class="list-group list-group-flush">
        {% for u in devUsers %}
        <form method="post" action="/admin/dev-login" class="m-0">
          <input type="hidden" name="userId" value="{{ u.id }}">
          <input type="hidden" name="next" value="{{ next }}">
          <button type="submit" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
            <span>
              <strong>{{ u.nombre }}</strong><br>
              <small class="text-secondary">{{ u.email }}</small>
            </span>
            <span class="badge text-bg-secondary">{{ u.roles }}</span>
          </button>
        </form>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
</body>

</html>
